# =====================================================================
# Portfolio Contact Form — Environment Configuration
# =====================================================================
# Copy this file to ".env" (or ".env.local") and fill in your keys.
# Then restart the dev server (npm run dev).
#
# Two delivery backends are supported:
#
#  1. EmailJS (recommended once you sign up) — fully automated, no
#     confirmation email required.  Create a free account at
#     https://www.emailjs.com/, create an email service + template,
#     and paste the credentials below.  IMPORTANT: in the EmailJS
#     template editor, set:
#       • From    → your verified email (a FIXED address, NOT {{from_email}})
#       • Reply-To → {{reply_to}}
#       • To      → {{to_email}}
#     This file already passes reply_to in the code, so replies will
#     go back to the person who filled in the form.
#
#  2. FormSubmit.co (no signup needed) — used automatically when the
#     EmailJS keys above are left blank.  On the very first submission
#     FormSubmit sends an "Activate Form" email to the destination
#     address (Samprit.code@gmail.com).  You MUST click the activation
#     link in that email once, otherwise messages will not be delivered.
# =====================================================================

# --- EmailJS (optional) ---
VITE_EMAILJS_SERVICE_ID= service_s90bao7
VITE_EMAILJS_TEMPLATE_ID= __ejs-test-mail-service__
VITE_EMAILJS_PUBLIC_KEY= g1cuSScU6pVDkKiF_

# --- FormSubmit (optional, override the default destination) ---
# VITE_FORMSUBMIT_EMAIL=Samprit.code@gmail.com
